{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LVC Affiliate",
  "version": "1.0.0",
  "identifier": "vn.lvcmedia.seedance",
  "build": {
    "frontendDist": "../../app/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../app dev",
    "beforeBuildCommand": "pnpm -C ../app build"
  },
  "app": {
    "windows": [
      {
        "title": "LVC Affiliate",
        "width": 1400,
        "height": 900,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExNUNFQzQyNjczMTRGQkIKUldTN1R6Rm5RdXhjRWZsSmREaDJzWWEwdWgrWEhXU1E3VEJ6bjZQekQyRVRXUzk2d3dHVDh6VE4K",
      "endpoints": [
        "https://github.com/GrayPham/lvc-affiliate-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
