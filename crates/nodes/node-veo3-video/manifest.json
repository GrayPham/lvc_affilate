    "type": "object",
    "properties": {
      "mode": {
        "type": "string",
        "title": "Che do",
        "enum": [
          "t2v",
          "r2v"
        ]
      },
      "model": {
        "type": "string",
        "title": "Model (rong = mac dinh theo mode)"
      },
      "aspect": {
        "type": "string",
        "title": "Ty le khung",
        "enum": [
          "portrait",
          "landscape"
        ]
      },
      "seed_count": {
        "type": "integer",
        "title": "So bien the (seed_count)",
        "minimum": 1
      },
      "account": {
        "type": "string",
        "title": "Tai khoan (ten/label credential Google, bat buoc)"
      }
