  "category": "video",
  "labelVi": "Tạo video Veo3",
  "inputs": [
    {
      "name": "prompt",
      "type": "text",
      "many": true,
      "required": true,
      "collect": false
    },
    {
      "name": "refs",
      "type": "image",
      "many": true,
      "required": false,
      "collect": false
    }
  ],
  "outputs": [
    {
      "name": "out",
      "type": "video",
      "many": true,
      "required": false,
      "collect": false
